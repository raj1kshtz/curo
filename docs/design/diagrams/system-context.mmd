---
config:
  theme: base
  layout: dagre
  flowchart:
    curve: linear
    nodeSpacing: 42
    rankSpacing: 64
    htmlLabels: true
  themeVariables:
    fontFamily: "Inter, ui-sans-serif, system-ui, sans-serif"
    fontSize: "16px"
    lineColor: "#64748B"
    textColor: "#0F172A"
---
flowchart TB
  operator["Operator<br/>Mode and safety bounds"]:::external

  subgraph requestRow[" "]
    direction LR

    subgraph host["Host Go process"]
      direction LR
      app["Application<br/>Business logic and HTTP client"]:::external
      curo["Curo library<br/>Observe, diagnose, mitigate"]:::api
      base["Base RoundTripper<br/>Original transport workflow"]:::external

      app -->|"wraps client"| curo
      curo -->|"delegates request and result"| base
    end

    dependency["HTTP dependency<br/>Upstream API or service"]:::external
    host -->|"base transport attempt and result"| dependency
  end

  telemetry["Audit and metrics<br/>Sanitized operational evidence"]:::observability

  operator -.->|"selects Curo authority"| requestRow
  requestRow -.->|"emits bounded Curo evidence"| telemetry

  classDef external fill:#F1F5F9,stroke:#475569,color:#0F172A,stroke-width:2px
  classDef api fill:#DBEAFE,stroke:#2563EB,color:#0F172A,stroke-width:2px
  classDef observability fill:#DCFCE7,stroke:#15803D,color:#0F172A,stroke-width:2px

  style host fill:#F8FAFC,stroke:#94A3B8,color:#0F172A,stroke-width:2px
  style requestRow fill:transparent,stroke:transparent
