---
config:
  theme: base
  layout: elk
  flowchart:
    curve: linear
    nodeSpacing: 38
    rankSpacing: 58
    htmlLabels: true
  themeVariables:
    fontFamily: "Inter, ui-sans-serif, system-ui, sans-serif"
    fontSize: "15px"
    lineColor: "#64748B"
    textColor: "#0F172A"
---
flowchart LR
  requests["Request goroutines<br/>No Curo goroutine per request"]:::external
  close["Close and reset<br/>Idempotent lifecycle control"]:::api
  clock["Injected clock<br/>Monotonic decision time"]:::api

  subgraph healer["Owned by one Curo instance"]
    direction LR
    control["Atomic control snapshot<br/>Mode, self-disable, policy"]:::safety
    worker["One maintenance worker<br/>Expiry and bounded cleanup"]:::state
    registry["Bounded target registry<br/>Admission and overflow"]:::state
    target["Per-target state<br/>Window, budget, breaker, timeout"]:::state

    control --> registry
    worker -->|"expire idle entries"| registry
    registry --> target
  end

  decision["Immutable decision snapshot<br/>No lock held across I/O"]:::analysis

  requests -->|"load and update"| control
  close -->|"cancel and join"| worker
  clock -.->|"time source"| target
  target --> decision

  classDef external fill:#F1F5F9,stroke:#475569,color:#0F172A,stroke-width:2px
  classDef api fill:#DBEAFE,stroke:#2563EB,color:#0F172A,stroke-width:2px
  classDef safety fill:#FFE4E6,stroke:#E11D48,color:#0F172A,stroke-width:2px
  classDef analysis fill:#EDE9FE,stroke:#7C3AED,color:#0F172A,stroke-width:2px
  classDef state fill:#CCFBF1,stroke:#0F766E,color:#0F172A,stroke-width:2px

  style healer fill:#F8FAFC,stroke:#94A3B8,color:#0F172A,stroke-width:2px
