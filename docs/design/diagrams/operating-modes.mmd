---
config:
  theme: base
  layout: dagre
  flowchart:
    curve: linear
    nodeSpacing: 34
    rankSpacing: 48
    htmlLabels: true
  themeVariables:
    fontFamily: "Inter, ui-sans-serif, system-ui, sans-serif"
    fontSize: "15px"
    lineColor: "#64748B"
    textColor: "#0F172A"
---
flowchart TB
  subgraph off["Off: direct pass-through"]
    direction LR
    o1["Request"]:::api
    o2["Atomic mode snapshot<br/>Off"]:::safety
    o3["Base transport<br/>Exactly one attempt"]:::external
    o4["Original result"]:::external
    o1 --> o2 --> o3 --> o4
  end

  subgraph observe["Observe: evidence without authority"]
    direction LR
    b1["Request"]:::api
    b2["Mode snapshot<br/>Observe"]:::safety
    b3["Base transport<br/>Unchanged attempt"]:::external
    b4["Record and diagnose<br/>Bounded evidence"]:::analysis
    b5["Proposed action<br/>Audit only"]:::observability
    b6["Original result"]:::external
    b1 --> b2 --> b3 --> b4 --> b5 --> b6
  end

  subgraph enforce["Enforce: bounded intervention"]
    direction LR
    e1["Request"]:::api
    e2["Mode snapshot<br/>Enforce"]:::safety
    e3["Policy snapshot<br/>Current evidence"]:::analysis
    e4["Mitigation coordinator<br/>Apply safety gates"]:::mitigation
    e5["Base transport<br/>Bounded attempts"]:::external
    e6["Record and return<br/>Selected result"]:::analysis
    e1 --> e2 --> e3 --> e4 --> e5 --> e6
  end

  off ~~~ observe
  observe ~~~ enforce

  classDef external fill:#F1F5F9,stroke:#475569,color:#0F172A,stroke-width:2px
  classDef api fill:#DBEAFE,stroke:#2563EB,color:#0F172A,stroke-width:2px
  classDef safety fill:#FFE4E6,stroke:#E11D48,color:#0F172A,stroke-width:2px
  classDef analysis fill:#EDE9FE,stroke:#7C3AED,color:#0F172A,stroke-width:2px
  classDef mitigation fill:#FEF3C7,stroke:#D97706,color:#0F172A,stroke-width:2px
  classDef observability fill:#DCFCE7,stroke:#15803D,color:#0F172A,stroke-width:2px

  style off fill:#F8FAFC,stroke:#94A3B8,color:#0F172A,stroke-width:2px
  style observe fill:#F0FDF4,stroke:#86EFAC,color:#0F172A,stroke-width:2px
  style enforce fill:#FFFBEB,stroke:#FCD34D,color:#0F172A,stroke-width:2px
