---
config:
  theme: base
  layout: dagre
  flowchart:
    curve: linear
    nodeSpacing: 36
    rankSpacing: 52
    htmlLabels: true
  themeVariables:
    fontFamily: "Inter, ui-sans-serif, system-ui, sans-serif"
    fontSize: "15px"
    lineColor: "#64748B"
    textColor: "#0F172A"
---
flowchart TB
  subgraph requestPath["Request control path"]
    direction LR
    transport["Transport adapter<br/>Explicit RoundTripper wrapper"]:::api
    guard["Guard<br/>Contain owned failures"]:::safety
    mode["Mode gate<br/>Snapshot request authority"]:::safety
    coordinator["Coordinator<br/>Apply bounded action plan"]:::mitigation
    base["Base RoundTripper<br/>Host-owned transport"]:::external

    transport --> guard --> mode --> coordinator --> base
  end

  subgraph analysisPath["Adaptive analysis path"]
    direction LR
    evidence["Captured attempt evidence<br/>Initial and retry outcomes"]:::analysis
    observe["Observer<br/>Bounded attempt evidence"]:::analysis
    diagnose["Diagnoser<br/>Class and readiness"]:::analysis
    policy["Policy evaluator<br/>Deterministic action plan"]:::analysis
    snapshot["Immutable action plan<br/>Current retry or later request"]:::analysis

    evidence --> observe --> diagnose --> policy --> snapshot
  end

  requestPath <-.->|"evidence and immutable plan exchange"| analysisPath

  classDef external fill:#F1F5F9,stroke:#475569,color:#0F172A,stroke-width:2px
  classDef api fill:#DBEAFE,stroke:#2563EB,color:#0F172A,stroke-width:2px
  classDef safety fill:#FFE4E6,stroke:#E11D48,color:#0F172A,stroke-width:2px
  classDef analysis fill:#EDE9FE,stroke:#7C3AED,color:#0F172A,stroke-width:2px
  classDef mitigation fill:#FEF3C7,stroke:#D97706,color:#0F172A,stroke-width:2px
  style requestPath fill:#F8FAFC,stroke:#94A3B8,color:#0F172A,stroke-width:2px
  style analysisPath fill:#F5F3FF,stroke:#C4B5FD,color:#0F172A,stroke-width:2px
